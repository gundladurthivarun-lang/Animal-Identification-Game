2184\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"context_sharing_url\":\"https://help.openai.com/en/articles/11487775-apps-in-chatgpt#what-does-chatgpt-share-with-apps\",\"elevated_risk_url\":\"https://help.openai.com/en/articles/20001062-elevated-risk-labels\",\"sensitive_actions_url\":\"https://help.openai.com/en/articles/11487775-apps-in-chatgpt#important-actions\"},\"is_device_based\":false,\"passed\":false},\"2712016364\":{\"name\":\"2712016364\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"staleTimeMs\":300001,\"gcTimeMs\":1800001},\"is_device_based\":false,\"passed\":false},\"4232437627\":{\"name\":\"4232437627\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":18,\"id_type\":\"userID\",\"value\":{\"asdk_app_697d413990c88191a2bf4799604f8f6c\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\",\"asdk_app_693ae33dd0f081918003ca256fe1126b\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\"},\"is_device_based\":false,\"passed\":false},\"2302071098\":{\"name\":\"2302071098\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"videoUrl\":\"https://persistent.oaistatic.com/deep-research/nux.070152025.mp4\",\"posterUrl\":\"https://persistent.oaistatic.com/deep-research/nux.070152025.jpg\"},\"is_device_based\":false,\"passed\":false},\"3406517345\":{\"name\":\"3406517345\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":23,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"3131667714\":{\"name\":\"3131667714\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":39,\"id_type\":\"userID\",\"value\":{\"supported_regions_merge_connector\":[\"us\",\"eu\",\"jp\"],\"regions\":[\"us\",\"eu\",\"jp\",\"au\",\"ae\",\"kr\",\"sg\",\"gb\",\"ca\",\"in\"]},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"2347841422\":{\"name\":\"2347841422\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"507401100\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":28,\"id_type\":\"userID\",\"value\":{\"enabled_entity_categories\":[\"local_business\",\"restaurant\",\"product_rationale_and_reviews\"]},\"is_device_based\":false,\"passed\":false},\"2826703856\":{\"name\":\"2826703856\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1355972088\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"949606265\",\"gateValue\":\"false\",\"ruleID\":\"2lpDctfCjGOqtuDHlE1jca:0.00:2\"},{\"gate\":\"1475533758\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":134,\"id_type\":\"workspace_id\",\"value\":{\"enable_combined_rbac_page\":true},\"is_device_based\":false,\"passed\":false},\"463092697\":{\"name\":\"463092697\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4113286138\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"251005210\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"733205176\",\"gateValue\":\"false\",\"ruleID\":\"1PJvsr1PFO2C35xU6YPcnd\"}],\"version\":397,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"1546790766\":{\"name\":\"1546790766\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1033995237\",\"gateValue\":\"true\",\"ruleID\":\"FaUk3JKtCg9OgWvTRDYOK\"},{\"gate\":\"96020071\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2040440245\",\"gateValue\":\"false\",\"ruleID\":\"327H9DtBsoN0NeJOlmVJij\"},{\"gate\":\"225888775\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3539777877\",\"gateValue\":\"false\",\"ruleID\":\"2P7rzuCnrrJe6VUn9e4Xjm\"},{\"gate\":\"2185729796\",\"gateValue\":\"false\",\"ruleID\":\"BDQmFLQslOUw2xpliRYOq:0.00:2\"}],\"version\":46,\"id_type\":\"userID\",\"value\":{\"enab